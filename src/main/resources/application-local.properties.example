### Gemini Cli Default Profile ### 

spring.application.name=book-processing

# Database Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.datasource.url=jdbc:postgresql://localhost:5432/book-processing
spring.datasource.username=postgres
spring.datasource.password=Czarodziej1#

# File Upload Limits
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# Virtual Threads
spring.threads.virtual.enabled=true

# AI Configuration
spring.ai.ollama.chat.model=gemma3:4b

# Logging Configuration
logging.level.com.orio.book_processing=DEBUG

# CORS Configuration
app.cors.allowed-origins=http://localhost:*

# JWT
security.jwt.secret=replace-with-a-long-random-secret-at-least-32-characters
security.jwt.expiration-ms=3600000